#!/bin/bash

#This is a shell script which calls sync_jacobi

if [[ $# < 1 ]]; then
  echo "usage: @exe@ starting_port_number"
  exit 1
fi

STARTING_PORT=$1

number_of_trials=2

# This is the basic 4x4 example. This usually works.
matrix_name=toy
size_of_system=4

# matrix_name=randomInteger_10_diagDom_100
# size_of_system=10

# TODO: Add preprocessing step here to work from on .mtx file for each matrix/vector

# Number of components each process updates from a row-wise partitioned matrix.
starting_number_of_updated_components=1;
ending_number_of_updated_components=2;

# trap kill_progs EXIT
# kill_progs() {
#    for (( counter_for_network_elements=0 ;  counter_for_network_elements < size_of_system ; counter_for_network_elements++ )); do
#     kill -9 ${!var} > /dev/null 2> /dev/null
#     let counter_for_network_elements++
#   done
# }

# folder which stores results for aggregation.
rm -r data_hold/
mkdir data_hold

echo -e Redundant Asyn Jacobi: '\t'  matrix: ${matrix_name} '\t' redundancy: $((starting_number_of_updated_components-1)) to $((ending_number_of_updated_components-1)) '\t' number of trials each: ${number_of_trials}

for (( redundancy_counter=starting_number_of_updated_components ; redundancy_counter<$((ending_number_of_updated_components+1)) ; redundancy_counter++ )); do
  for (( counter_for_trials = 1 ; counter_for_trials < $((number_of_trials+1)) ; counter_for_trials++ )); do
      echo Begin: Redundancy ${redundancy_counter} Trial ${counter_for_trials}
      for (( counter_for_network_elements=0 ;  counter_for_network_elements < size_of_system ; counter_for_network_elements++ )); do
        # echo "@async_jacobi_exe@" ${counter_for_network_elements} ${STARTING_PORT} ${size_of_system} ${matrix_name} ${number_of_updated_components} ${root_pathway}
        if [[ ${counter_for_network_elements} < $((size_of_system-1)) ]]
        then
          "@async_jacobi_exe@" ${counter_for_network_elements} ${STARTING_PORT} ${size_of_system} ${matrix_name} ${redundancy_counter} ${counter_for_trials} &
        else
          "@async_jacobi_exe@" ${counter_for_network_elements} ${STARTING_PORT} ${size_of_system} ${matrix_name} ${redundancy_counter} ${counter_for_trials}
        fi
        # "@sync_jacobi_exe@" ${i} > /dev/null 2> /dev/null &
        # declare "erase${counter_for_network_elements}=$!"
      done
      echo Complete: Redundancy ${redundancy_counter} Trial ${counter_for_trials}
      sleep 2
      STARTING_PORT=$((STARTING_PORT+size_of_system+100))
    done
done


# This block is for data aggregation.
# This passes synchronous results directory for comparison analysis.
sync_comparison_results_directory="../sync_jacobi/data_hold/"
# This passes the file names needed for computing residuals  and forward errors.
solution_vector_filename="../../../examples/jacobi_include/system_hold_folder/sol_hold_folder/x_sol_"${matrix_name}
rhs_vector_filename="../../../examples/jacobi_include/system_hold_folder/rhs_hold_folder/rhs_"${matrix_name}

# This is the actual python code for the data aggregation and graph generation.
# python3 ../../../examples/jacobi_include/data_aggregation/asynchronous_jacobi_post_processing.py ${starting_number_of_updated_components} ${ending_number_of_updated_components} ${size_of_system} ${number_of_trials} ${sync_comparison_results_directory} ${solution_vector_filename} ${rhs_vector_filename}
