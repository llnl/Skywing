#!/bin/bash

#This is a shell script which calls sync_jacobi

if [[ $# < 1 ]]; then
  echo "usage: @exe@ starting_port_number"
  exit 1
fi

STARTING_PORT=$1

trap kill_progs EXIT
kill_progs() {
  for (( counter_for_network_elements=0 ;  counter_for_network_elements < size_of_network ; counter_for_network_elements++ ))
  do
      var="erase${counter_for_network_elements}"
    kill -9 ${!var} > /dev/null 2> /dev/null
  done
}

# For this implementation, the number of rows in the matrix has to correspond to the size of the network.
size_of_network=4
matrix_name="toy.mtx"

# matrix_name="randomInteger_10_diagDom_100.mtx"
# size_of_network=10

number_of_trials=1

# Number of components each process updates from a row-wise partitioned matrix.
# This implementation allows for overlapping computations.
starting_number_of_rows=1;
ending_number_of_rows=1;

directory="../../../examples/async_jacobi/system/partition"
# TODO: Add preprocessing step here to work from on .mtx file for each matrix/vector

# folder which stores results for aggregation.
rm -r data_hold/
mkdir data_hold

echo -e Asyn Jacobi: '\t'  matrix: ${matrix_name} '\t' Row Count: ${starting_number_of_rows} to ${ending_number_of_rows} '\t' number of trials each: ${number_of_trials}

for (( row_counter=starting_number_of_rows ; row_counter<=ending_number_of_rows ; row_counter++ ))
do
  for (( counter_for_trials = 1 ; counter_for_trials <= number_of_trials ; counter_for_trials++ ))
  do
      echo Begin: Redundancy ${row_counter} Trial ${counter_for_trials}
      for (( counter_for_network_elements=0 ;  counter_for_network_elements < size_of_network ; counter_for_network_elements++ ))
      do
        if [[ ${counter_for_network_elements} < $((size_of_network-1)) ]]
        then
          "@async_jacobi_exe@" ${counter_for_network_elements} ${STARTING_PORT} ${size_of_network} ${matrix_name} ${row_counter} ${directory} ${counter_for_trials} &
        else
          "@async_jacobi_exe@" ${counter_for_network_elements} ${STARTING_PORT} ${size_of_network} ${matrix_name} ${row_counter} ${directory} ${counter_for_trials}
        fi
        declare "erase${counter_for_network_elements}=$!"
      done
      sleep 1
      echo Complete: Redundancy ${row_counter} Trial ${counter_for_trials}
      STARTING_PORT=$((STARTING_PORT+size_of_network+100))
    done
done


# This block is for data aggregation.
# This passes synchronous results directory for comparison analysis.
sync_comparison_results_directory="../sync_jacobi/data_hold/"
# This passes the file names needed for computing residuals  and forward errors.
solution_vector_filename="../../../examples/jacobi_include/system_hold_folder/sol_hold_folder/x_sol_"${matrix_name}
rhs_vector_filename="../../../examples/jacobi_include/system_hold_folder/rhs_hold_folder/rhs_"${matrix_name}

# This is the actual python code for the data aggregation and graph generation.
# python3 ../../../examples/jacobi_include/data_aggregation/asynchronous_jacobi_post_processing.py ${starting_number_of_rows} ${ending_number_of_rows} ${size_of_network} ${number_of_trials} ${sync_comparison_results_directory} ${solution_vector_filename} ${rhs_vector_filename}
