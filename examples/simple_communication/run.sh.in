#!/bin/bash


#This is a shell script which calls simple_communication.


trap kill_progs EXIT

#this deletes kill_progs on Exit, which deletes the temporary file.

#kill -9 sends a kill signal to whatever follows.
#> is for redirect
#/dev/null is where any data will be sent, which discards all data sent to it and yields no output
#${} is a way to call variables, and the braces are a way to resolve ambiguity
#

kill_progs() {
  for i in 0 1 ; do
    var="erase${i}"
     kill -9 ${!var} > /dev/null 2> /dev/null
  done
}

#"declare" keyword is used to declare variable
#" " double quotes display the real meaning of special variables.
#"$!"" contains the process ID of the last job that was backgrounded.
#"&" allows the shell script to continue and we do not have to wait until the script is finished before continuing.

for i in 0 1 ; do
  "@simple_communication@" ${i} > /dev/null 2> /dev/null &
  declare "erase${i}=$!"
done

#what is the syntax of " " followed by integer?
"@simple_communication@" 2
