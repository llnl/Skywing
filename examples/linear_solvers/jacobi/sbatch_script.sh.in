#!/bin/bash
#SBATCH -N 3
#SBATCH -J skywing_jacobi
#SBATCH -t 00:05:00
#SBATCH -p pdebug
#SBATCH -o jacobi.txt
#SBATCH --ip-isolate=yes

#### Shell commands
python3 generate_config_info.py num_agents=3 node_list=$SLURM_NODELIST port_start=30000 config_filename=config.cfg
echo "SLURM_NODELIST is $SLURM_NODELIST"
echo " "
srun -n3 ./call_executable.sh #"@jacobi_exe@" config.cfg $SLURM_NODEID $SLURM_LOCALID 1 
