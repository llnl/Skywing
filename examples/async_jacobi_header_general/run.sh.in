#!/bin/bash

#This is a shell script which calls sync_jacobi_header_general

if [[ $# < 1 ]]; then
  echo "usage: @exe@ starting_port_number"
  exit 1
fi

STARTING_PORT=$1
size_of_system=4
matrix_file_name=toy_matrix.mtx
rhs_file_name=toy_rhs.mtx
sol_file_name=toy_sol.mtx
number_of_updated_components=2

counter=0

trap kill_progs EXIT
kill_progs() {
  for i in 0 1 2 3; do
    var="erase${i}"
    kill -9 ${!var} > /dev/null 2> /dev/null
  done
}

while [[ ${counter} < ${size_of_system} ]];do
  echo "@async_jacobi_header_general_exe@" ${counter} ${STARTING_PORT} ${size_of_system} $matrix_file_name ${rhs_file_name} ${sol_file_name} ${number_of_updated_components}
  "@async_jacobi_header_general_exe@" ${counter} ${STARTING_PORT} ${size_of_system} $matrix_file_name ${rhs_file_name} ${sol_file_name} ${number_of_updated_components} &
  declare "erase${i}=$!"
  let counter++;
  # "@sync_jacobi_header_general_exe@" ${i} > /dev/null 2> /dev/null &
  # declare "erase${i}=$!"
done
